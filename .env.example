# AgentSentinel Environment Configuration
# Copy this file to .env and adjust as necessary for deployment.

# ==========================================
# Database Configuration
# ==========================================
# SQLite is used by default. Ensure this points to a stable path.
DATABASE_URL=sqlite:///./agentsentinel.db

# ==========================================
# Ollama Local Model Configuration
# ==========================================
# The API expects Ollama to be running on the host machine.
# By default, Ollama binds to 127.0.0.1:11434.
OLLAMA_HOST=http://127.0.0.1:11434

# The target Ollama model for evaluation. qwen3:4b is required.
OLLAMA_MODEL=qwen3:4b

# ==========================================
# Alternate LLM Provider (Optional)
# ==========================================
# If OLLAMA_HOST is intentionally left blank, you can use these keys.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=

# ==========================================
# Testing & Runtime Flags
# ==========================================
# Set to "1" to enable Development/Testing mode (bypasses real Ollama)
AGENTSENTINEL_TEST_MODE=0
